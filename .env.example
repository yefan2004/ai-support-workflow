# ============================================================
# 本地演示配置示例（复制为 .env 后按需修改）
# 警告：以下全部是演示值，不包含任何真实密钥；.env 已被 .gitignore 忽略。
# ============================================================

# --- 应用 ---
APP_NAME=AI Support Workflow
APP_ENV=local
APP_VERSION=0.1.0

# --- PostgreSQL（与 docker-compose.yml 默认值保持一致）---
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=ai_support
POSTGRES_PORT=5432
DATABASE_URL=postgresql://demo:demo@localhost:5432/ai_support

# --- 后续阶段占位（本阶段不实现，请勿填写真实密钥）---
# OPENAI_API_KEY=
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
# SLACK_WEBHOOK_URL=
