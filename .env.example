# ============================================================
# 本地演示配置示例（复制为 .env 后按需修改）
# 警告：以下全部是演示值，不包含任何真实密钥；.env 已被 .gitignore 忽略。
# ============================================================

# --- 应用 ---
APP_NAME=AI Support Workflow
APP_ENV=local
APP_VERSION=0.1.0

# --- PostgreSQL（与 docker-compose.yml 默认值保持一致）---
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=ai_support
POSTGRES_PORT=5432
# 注意：SQLAlchemy 需要驱动前缀，psycopg 3 使用 postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://demo:demo@localhost:5432/ai_support

# 测试默认使用独立测试库（清理 fixture 仅允许清空 ai_support_test）：
TEST_DATABASE_URL=postgresql+psycopg://demo:demo@localhost:5432/ai_support_test

# --- AI Provider ---
# 默认 mock：离线、确定性，不调用外部 API。
AI_PROVIDER=mock
# 仅当 AI_PROVIDER=deepseek 时需要；不要把真实 Key 提交到仓库。
# 启用 deepseek 时，邮件主题和正文会发送给第三方模型。
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30

# --- 其他后续阶段占位（本阶段不实现，请勿填写真实密钥）---
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
# SLACK_WEBHOOK_URL=
