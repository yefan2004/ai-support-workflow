FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

# Optional build-time override for networks where the default PyPI index is
# slow or unavailable. It is not a runtime secret.
ARG PIP_INDEX_URL=https://pypi.org/simple

WORKDIR /app

# Install dependencies before copying the UI entrypoint.
COPY requirements.txt ./
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt

# The Streamlit UI only needs its own entrypoint; it calls the API over HTTP.
COPY frontend_app.py ./

EXPOSE 8501

CMD ["streamlit", "run", "frontend_app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
