FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

# Optional build-time override for networks where the default PyPI index is
# slow or unavailable. It is not a runtime secret.
ARG PIP_INDEX_URL=https://pypi.org/simple

WORKDIR /app

# Install runtime dependencies before copying application code.
COPY requirements.txt ./
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt

# Copy only the files required to run the API and Alembic migrations.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./

EXPOSE 8000

# Single-instance demo simplification: migrate once, then start the API.
# The Compose service waits for PostgreSQL to be healthy before this starts.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
